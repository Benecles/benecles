VER = '20260925d'
def page(fname, n, title, desc, kicker, h1a, h1b, deck, hero, tb, body, prev, nxt, extra_css='', unit=''):
    kick = ''.join(f'<span>{k}</span>' for k in kicker)
    tbh = ''.join(f'<div role="listitem">{a}<b>{b}</b></div>' for a, b in tb)
    head = HEAD.format(ver=VER, unit=unit, title=title, desc=desc, n=n, kicker=kick, h1a=h1a, h1b=h1b, deck=deck, hero=hero, tb=tbh,
                       extra_css=f'<style>{extra_css}</style>\n' if extra_css else '')
    nav = ('<nav class="endnav" aria-label="Aulas vizinhas">'
           f'<a href="{prev[0]}"><span>{prev[1]}</span>{prev[2]}</a>'
           f'<a href="{nxt[0]}" style="text-align:right"><span>{nxt[1]}</span>{nxt[2]}</a></nav>\n')
    html = head + body + nav + '<script src="assets/curso.js?v=' + VER + '"></script>\n</body>\n</html>\n'
    open(OUT + fname, 'w').write(html)
    FIGN[0] = 0
    if WARN:
        print('\n'.join('  WARN ' + w for w in WARN))
        WARN.clear()
    print('wrote', fname, len(html), 'bytes')
