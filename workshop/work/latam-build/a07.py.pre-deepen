from common import *

# hero: many individual claims → one structural order
cells = ''.join(f'<rect x="{60 + (i % 10) * 26}" y="{40 + (i // 10) * 26}" width="18" height="18" style="fill:var(--conc-wash);stroke:var(--conc);stroke-width:1.5"/>' for i in range(40))
hero = (f'<g class="pop" style="--d:.1s">{cells}</g>'
        '<text x="190" y="160" text-anchor="middle" style="font:12px var(--mono);letter-spacing:1px;fill:var(--conc)">MILHARES DE TUTELAS INDIVIDUAIS</text>'
        '<path class="draw" d="M340 85H640" style="fill:none;stroke:var(--ink);stroke-width:3;--d:.6s"/>'
        '<path class="draw" d="M626 76L642 85L626 94" style="fill:none;stroke:var(--ink);stroke-width:3;--d:.9s"/>'
        '<g class="pop" style="--d:1.2s"><rect x="660" y="40" width="360" height="90" style="fill:var(--dif-wash);stroke:var(--dif);stroke-width:2"/>'
        '<text x="840" y="78" text-anchor="middle" style="font:600 13px var(--mono);letter-spacing:1px;fill:var(--dif)">UMA ORDEM ESTRUTURAL</text>'
        '<text x="840" y="102" text-anchor="middle" style="font:12px var(--mono);fill:var(--ink-2)">plano · orçamento · prazos · acompanhamento</text></g>')

# ---- Fig: remedy architecture, T-153 vs ADPF 347
def remedy(k):
    o = T(40, 56, 'COMO O REMÉDIO FUNCIONA', 't-small', style='letter-spacing:.1em')
    if k == 0:
        o += G(box(40, 80, 520, 80, 'T-153/1998 · CORTE CONSTITUCIONAL', 'ordens diretas, prazos fixos', 'conc', ctx='rm'), 'pop', d=.1)
        o += P('M300 160V200', 'c-conc grow', style='--d:.3s')
        o += G(box(40, 200, 520, 110, 'INPEC · JUSTIÇA · PLANEJAMENTO', 'plano de construção e reforma em 3 meses;', 'grey', ctx='rm', sub2='recursos no orçamento; execução em 4 anos'), 'pop', d=.5)
        o += P('M300 310V350', 'thin grow', style='--d:.7s')
        o += G(box(40, 350, 520, 80, 'DEFENSORÍA E PROCURADURÍA', 'supervisionam, sem processo contínuo', 'grey', ctx='rm'), 'pop', d=.9)
        o += G(T(300, 480, 'sem indicadores, sem participação, sem volta à Corte', 't-hand', anchor='middle'), 'fade', d=1.1)
    else:
        o += G(box(40, 80, 520, 80, 'ADPF 347 · STF (MÉRITO, 2023)', 'fixa objetivos e a estrutura de acompanhamento', 'dif', ctx='rm'), 'pop', d=.1)
        o += P('M300 160V200', 'c-dif grow', style='--d:.3s')
        o += G(box(40, 200, 250, 110, 'UNIÃO', 'plano nacional', 'grey', ctx='rm', sub2='em 6 meses'), 'pop', d=.5)
        o += G(box(310, 200, 250, 110, 'ESTADOS E DF', 'planos próprios, 6 meses', 'grey', ctx='rm', sub2='após a homologação'), 'pop', d=.6)
        o += G(T(300, 338, 'com o DMF/CNJ', 't-small tc-dif', anchor='middle'), 'fade', d=.7)
        o += P('M300 350V380', 'c-dif grow', style='--d:.8s')
        o += G(box(40, 380, 520, 80, 'HOMOLOGAÇÃO JUDICIAL', 'e monitoramento da execução (até 3 anos)', 'dif', ctx='rm'), 'pop', d=1)
        o += P('M560 420C600 420 600 120 560 120', 'c-dif grow', style='--d:1.2s')
        o += G(T(300, 510, 'o processo volta à Corte: é um ciclo, não uma ordem', 't-hand', anchor='middle'), 'fade', d=1.4)
    return o

b = ''
b += chapter('01', 'c1', 'Quando o problema é o sistema', 'Algumas violações não têm um único culpado nem se resolvem com uma ordem a uma autoridade.', 'dif')
b += longform(
    '<p>O processo tradicional imagina uma pessoa lesada, uma autoridade responsável e uma ordem capaz de reparar a violação. Cumprida a ordem, o processo acaba. Há violações, porém, que resultam do funcionamento conjunto de leis, decisões judiciais, práticas administrativas, escolhas orçamentárias e omissões repetidas. Nesses casos, proteger apenas quem ajuizou a ação não altera o mecanismo, que continuará produzindo novas lesões.</p>',
    '<p>O <strong>estado de coisas inconstitucional (ECI)</strong> é a técnica que torna visível essa relação entre violação de direitos e funcionamento institucional. A professora resume seus elementos assim: a violação atinge muitas pessoas e persiste no tempo; suas causas não pertencem a uma única instituição; as autoridades conhecem o problema, mas respostas fragmentadas não conseguem modificá-lo; e a superação depende de medidas articuladas, recursos públicos e mudanças na forma de decidir e administrar.</p>',
    '<p>A expressão nasceu na Colômbia. A Corte Constitucional a usou pela primeira vez na <strong>SU-559/1997</strong>, sobre o não pagamento de contribuições previdenciárias de professores, e voltou a ela na <strong>T-068/1998</strong>, sobre a ineficiência generalizada da Caja Nacional de Previsión. A <strong>T-153/1998</strong> não inventou a categoria: levou-a ao sistema penitenciário e ampliou o alcance das ordens.</p>')

b += bet('Dois presos pedem, por tutela, o fim da superlotação nas suas prisões. As provas mostram que o problema é de todo o sistema carcerário. O que a Corte deve fazer?', [
    ('Decidir só para eles: tutela protege quem pediu, e obras dependem do orçamento.', 'Tribunal de Medellín e Corte Suprema'),
    ('Declarar um estado de coisas inconstitucional e dar ordens às instituições responsáveis pelo sistema.', '*Corte Constitucional (T-153/1998)'),
], '<p>As instâncias anteriores negaram a tutela; a Corte Constitucional escolheu a segunda resposta. O capítulo abaixo mostra como ela transformou dois pedidos individuais num diagnóstico nacional, e o que isso custou em efetividade.</p>')
b += chapter('02', 'c2', 'T-153/1998: as prisões colombianas', 'Duas tutelas de presos se transformaram num diagnóstico nacional.')
b += longform(
    '<p>O caso começa com dois pedidos concretos. Em Bellavista (Medellín), Manuel José Duque Arcila ajuizou tutela contra o Ministério da Justiça e o INPEC pedindo que o Estado descongestionasse a prisão; disse que a ação serviria para não continuar submetido a condições que descreveu como tortura. Em La Modelo (Bogotá), Jhon Jairo Hernández e outros presos do Comitê Permanente de Direitos Humanos questionaram uma reforma que colocaria ao menos quatro pessoas em celas de 6,60 m². Nenhum deles pediu uma reforma penitenciária nacional; a dimensão estrutural surgiu quando a Corte relacionou os casos individuais com o sistema.</p>',
    '<p>As instâncias anteriores negaram as duas tutelas. O Tribunal de Medellín e a Corte Suprema reconheceram a gravidade, mas entenderam que a tutela não podia impor obras que dependessem de gasto público. Esse é o dilema do tema inteiro: direitos fundamentais podem exigir decisões com efeitos orçamentários e administrativos?</p>',
    '<p>A Sala Tercera de Revisión (relator Eduardo Cifuentes Muñoz, com Carlos Gaviria Díaz e José Gregorio Hernández Galindo) mudou a escala do processo. Requisitou informações ao Ministério da Justiça, ao INPEC, à Defensoría del Pueblo, à Procuraduría, à Fazenda, ao Planejamento Nacional, à Saúde e à Polícia, e inspecionou as duas prisões. Bellavista tinha capacidade para cerca de 1.700 pessoas e abrigava 4.969; La Modelo, feita para 1.800, recebia mais de 4.500. Havia pessoas dormindo em corredores e banheiros, falta de água, violência e nenhuma separação entre presos provisórios e condenados.</p>',
    lex('Corte Constitucional, T-153/1998', 'Las cárceles colombianas se caracterizan por el hacinamiento, las graves deficiencias en materia de servicios públicos y asistenciales, el imperio de la violencia, la extorsión y la corrupción, y la carencia de oportunidades y medios para la resocialización.'),
    '<p>A partir daí a Corte formulou o ECI para situações de violação de direitos fundamentais de <strong>caráter geral</strong> e com <strong>causas estruturais</strong>, cuja solução exige a atuação conjunta de diferentes entidades. Dois argumentos justificam ir além das partes. Um é prático: se cada preso nas mesmas condições precisasse ajuizar sua tutela, milhares de processos repetiriam o mesmo diagnóstico. O outro é de legitimidade: o juiz constitucional deve assumir "la vocería de las minorías olvidadas", grupos que dificilmente têm acesso aos órgãos políticos, como as pessoas presas.</p>',
    '<p><strong>As ordens.</strong> INPEC, Ministério da Justiça e Planejamento Nacional deveriam elaborar em três meses um plano de construção e reforma prisional; o governo deveria incluir os recursos nos orçamentos e no Plano Nacional de Desenvolvimento; a execução deveria terminar em quatro anos, sob supervisão da Defensoría e da Procuraduría. A Corte suspendeu imediatamente a reforma de La Modelo, mandou transferir integrantes da força pública para estabelecimentos especiais em três meses e separar presos provisórios de condenados em quatro anos. A decisão foi unânime, sem aclaración nem salvamento de voto.</p>',
    '<h3>Os limites da T-153</h3>',
    '<p>A própria Corte percebeu que o problema das prisões "no se soluciona únicamente con dinero y construcciones" e que no país ainda primava uma concepção carcerária do direito penal. Mesmo assim, o dispositivo investiu sobretudo em vagas. Libardo Ariza aponta o paradoxo: a Corte assume a voz das pessoas marginalizadas "para ordenar la construcción de más y mejores cárceles donde encerrarlas". César e Diana Rodríguez observaram que, sem um mecanismo de acompanhamento, a sentença teve “efectos temporales y limitados”. Ariza corrige a frase: os efeitos foram limitados na proteção da pessoa presa, mas “amplios y permanentes” no crescimento da prisão. A crise continuou, e a Corte teve de voltar ao sistema penitenciário na T-388/2013 e na T-762/2015.</p>')

b += chapter('03', 'c3', 'ADPF 347: o sistema carcerário brasileiro', 'O STF reconheceu o ECI em 2015 e desenhou o remédio no mérito, em 2023.', 'dif')
b += longform(
    '<p>O legitimado formal foi o <strong>PSOL</strong>, porque partidos com representação no Congresso podem propor ADPF; a estratégia de litígio veio da Clínica de Direitos Fundamentais da Faculdade de Direito da UERJ, coordenada por Daniel Sarmento. A ADPF foi escolhida porque o objeto não era uma lei, mas um conjunto de atos e omissões de diferentes poderes (política criminal, decisões judiciais, administração penitenciária, orçamento) que mantinha uma realidade incompatível com preceitos fundamentais.</p>',
    '<p>A petição descreveu violações generalizadas à dignidade, à integridade, à saúde, à alimentação, ao trabalho, à educação e ao acesso à Justiça, e pediu dois tipos de medida: reduzir a entrada e o tempo de prisão (fundamentação rigorosa da prisão cautelar, audiências de custódia, considerar as condições carcerárias ao decidir sobre prisão e pena, penas alternativas) e reorganizar a política penitenciária (liberar o FUNPEN, planos nacional e estaduais com metas, recursos e acompanhamento).</p>',
    '<p><strong>A cautelar.</strong> Em 9 de setembro de 2015, o STF reconheceu cautelarmente o estado de coisas inconstitucional, mas dos oito pedidos acolheu dois: audiências de custódia em até 24 horas e liberação do saldo do Fundo Penitenciário Nacional, com vedação de novos contingenciamentos.</p>',
    '<p><strong>O mérito.</strong> O julgamento começou no plenário virtual em 2021, com o voto do relator Marco Aurélio. Após sua aposentadoria, Luís Roberto Barroso pediu destaque e reorganizou as medidas. O julgamento terminou em <strong>4 de outubro de 2023</strong>, com a ação julgada parcialmente procedente segundo a proposta de Barroso, redator do acórdão, acompanhado por Cristiano Zanin, Nunes Marques, Alexandre de Moraes, Edson Fachin, Luiz Fux, Dias Toffoli, Cármen Lúcia e Gilmar Mendes. Marco Aurélio ficou parcialmente vencido; André Mendonça não votou porque o voto do relator originário já tinha sido lançado. A divergência não era sobre a existência da crise, mas sobre o alcance das providências.</p>',
    lex('STF, ADPF 347, tese de julgamento', 'Há um estado de coisas inconstitucional no sistema carcerário brasileiro, responsável pela violação massiva de direitos fundamentais dos presos. Tal estado de coisas demanda a atuação cooperativa das diversas autoridades, instituições e comunidade para a construção de uma solução satisfatória.'))
b += scrolly('Dois remédios estruturais', [('p-rm0', remedy(0), 'T-153'), ('p-rm1', remedy(1), 'ADPF 347')], [
    S('p-rm0', 'T-153/1998', 'Ordens diretas e acompanhamento fraco', '<p>A decisão colombiana fixou prazos e distribuiu deveres, mas não criou um processo judicial contínuo, participativo e baseado em indicadores de resultado. A supervisão ficou com a Defensoría e a Procuraduría, e o caso não voltou à Corte de forma organizada.</p>', 'conc'),
    S('p-rm1', 'ADPF 347 · mérito', 'Planos, homologação e monitoramento', '<p>O STF definiu objetivos e a estrutura de acompanhamento, e deixou as medidas concretas para o Executivo e o CNJ. União, Estados e DF devem elaborar planos com o Departamento de Monitoramento e Fiscalização do CNJ, enfrentando superlotação, baixa qualidade das vagas e fluxos de entrada e saída. A União tinha seis meses para o plano nacional; após a homologação, Estados e DF, outros seis meses; a implementação, até três anos. Os prazos transformam a decisão em processo.</p>', 'dif'),
])

b += chapter('04', 'c4', 'Diálogo ou monólogo?', 'O ECI amplia o alcance da Corte. A pergunta é se ela coordena ou passa a governar.')
b += longform(
    '<p>Katya Kozicki e Bianca van der Broocke defendem uma leitura dialógica da ADPF 347: são as <strong>audiências públicas de monitoramento</strong> que dão legitimidade às medidas estruturais. Para as autoras, a participação precisa produzir deliberação e controle do cumprimento; uma audiência apenas informativa não é diálogo suficiente.</p>',
    '<p>O ganho constitucional do ECI é real: conecta direitos, políticas públicas e responsabilidade institucional, dá visibilidade a grupos com pouca influência política e obriga as instituições a produzir informação, justificar escolhas e assumir compromissos verificáveis. O risco também: se o tribunal formula a política em detalhe, escolhe prioridades orçamentárias e controla a execução indefinidamente, a cooperação vira tutela judicial dos demais poderes; se o processo exclui as pessoas atingidas, o diálogo fica restrito às instituições que produziram o problema.</p>')
b += wide(table(['', 'Constitucionalismo dialógico', 'Sinais de monólogo'], [
    ['A Corte', 'Fixa o conteúdo mínimo dos direitos e exige resultados.', 'Prescreve soluções fechadas.'],
    ['Os órgãos políticos', 'Escolhem os meios, apresentam razões e podem revisar estratégias.', 'Apenas executam.'],
    ['Pessoas afetadas e especialistas', 'Participam do processo.', 'Audiências servem só para coletar informação.'],
    ['O acompanhamento', 'Usa dados públicos e admite correções.', 'Não há critério para encerrar a supervisão.'],
], hcls=['', 'dif', 'conc']))
b += longform(
    eixo('Quando uma violação individual revela uma falha estrutural do Estado, qual deve ser o papel de uma Corte constitucional?'),
    '<p>A comparação entre as duas decisões organiza a resposta. As duas reconhecem violações massivas, causas institucionais múltiplas e a insuficiência das respostas ordinárias, e ambas vão além das partes. A diferença está no remédio: a T-153 mostra que uma decisão ousada pode ter efeitos limitados quando privilegia infraestrutura e não constrói acompanhamento; a ADPF 347 procura responder a isso com planos e monitoramento, mas ainda precisa mostrar participação efetiva das pessoas presas e mudança na política criminal, e não apenas uma administração mais organizada da superlotação. A pergunta final da professora serve de roteiro: quando a Corte deve iniciar, acompanhar e encerrar um processo estrutural?</p>',
    '<p>A aula de 21/09 continua exatamente daqui: o litígio estrutural e os diálogos institucionais, com a T-025/2004 sobre o deslocamento forçado na Colômbia.</p>')

b += chapter('05', 'c5', 'Teste', 'Responda antes de abrir.')
b += quiz([
    ('A T-153/1998 criou o estado de coisas inconstitucional?', 'Não. A Corte já usara a expressão na SU-559/1997 (previdência de professores) e na T-068/1998 (Cajanal). A T-153 levou a categoria ao sistema prisional e ampliou o alcance das ordens.'),
    ('Quais são os dois elementos centrais da formulação do ECI na T-153?', 'A generalidade da violação de direitos fundamentais (atinge muitas pessoas) e a causalidade estrutural (causas que não se originam só na autoridade demandada), exigindo atuação conjunta de várias entidades.'),
    ('Qual é a crítica de Libardo Ariza à T-153?', 'Que a Corte assume a voz das pessoas marginalizadas para ordenar a construção de mais e melhores prisões. Por isso ele matiza a leitura de que a sentença teve efeitos “temporários e limitados”: foram limitados na proteção da pessoa presa, mas amplos e permanentes na expansão do sistema carcerário.'),
    ('O que o STF concedeu na cautelar de 2015 da ADPF 347?', 'Reconheceu o ECI e acolheu dois dos oito pedidos: audiências de custódia em até 24 horas e liberação do saldo do FUNPEN, vedados novos contingenciamentos.'),
    ('Como o remédio do mérito (2023) difere das ordens da T-153?', 'O STF fixou objetivos e estrutura de acompanhamento e deixou as medidas para planos da União, Estados e DF, elaborados com o CNJ, submetidos à homologação judicial e monitorados com prazos. A T-153 deu ordens diretas de construção e reorganização, com supervisão limitada da Defensoría e da Procuraduría.'),
    ('Segundo Kozicki e Van der Broocke, o que legitima as medidas estruturais?', 'As audiências públicas de monitoramento, desde que produzam deliberação e controle do cumprimento; audiências apenas informativas não bastam.'),
])

lesson('07', 'aula-07.html', 'Estado de coisas inconstitucional',
       'A negação estrutural de direitos: o estado de coisas inconstitucional na Corte Constitucional colombiana (SU-559/1997, T-153/1998) e no STF (ADPF 347, cautelar de 2015 e mérito de 2023).',
       'Estado de coisas', 'inconstitucional',
       'Quando a violação é de muitos e tem causas em várias instituições, uma sentença individual não basta. O ECI permite à Corte <strong class="dif">ordenar ao sistema</strong>, e cria o risco de ela <strong class="conc">passar a administrá-lo</strong>.',
       hero, [('Aula', '14/09 · ECI'), ('Leitura', '≈ 22 min'), ('Antes', 'Aula 06 · Bolívia e OC-28'), ('Depois', 'Aula 08 · T-025')], b,
       ('aula-06.html', '← Aula 06', 'Reeleição e direitos políticos'), ('aula-08.html', 'Aula 08 →', 'T-025 e litígio estrutural'), '14/09')
