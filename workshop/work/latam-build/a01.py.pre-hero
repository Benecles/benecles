from common import *
from maps import latam_map, map_defs

# hero: a long line from 1791 to the courts, with the present marked on it
TL = [(80, '1791', 'Haiti', ('revolução dos', 'escravizados'), 'dif'),
      (250, '1810', 'Juntas', ('a soberania', '“volta” aos povos'), 'ink'),
      (420, '1812', 'Cádiz', ('cidadania com', 'fronteira racial'), 'conc'),
      (590, '1853', 'Pacto', ('liberal e', 'conservador'), 'ink'),
      (760, '1917', 'Querétaro', ('a Constituição', 'passa a exigir'), 'dif'),
      (930, '1980+', 'Redemocratização', ('novas cartas', 'e cortes fortes'), 'conc')]
hero = '<path class="draw" d="M60 70H1020" style="fill:none;stroke:var(--ink);stroke-width:3"/>'
for i, (x, y, a, b_, tone) in enumerate(TL):
    col = {'ink': 'var(--ink)', 'dif': 'var(--dif)', 'conc': 'var(--conc)'}[tone]
    hero += (f'<g class="pop" style="--d:{.2 + i * .2:.1f}s;font:12px var(--mono);letter-spacing:1px">'
             f'<circle cx="{x}" cy="70" r="7" style="fill:{col}"/>'
             f'<text x="{x}" y="46" text-anchor="middle" style="fill:{col}">{y}</text>'
             f'<text x="{x}" y="100" text-anchor="middle" style="fill:var(--ink)">{a}</text>'
             f'<text x="{x}" y="118" text-anchor="middle" style="fill:var(--ink-2);font-size:11px">{b_[0]}</text>'
             f'<text x="{x}" y="133" text-anchor="middle" style="fill:var(--ink-2);font-size:11px">{b_[1]}</text></g>')

# ---- Fig 1: 1791–1824 on the map, with a year strip in the Pacific
SPAIN = ['MEX','GTM','SLV','HND','NIC','CRI','PAN','CUB','DOM','PRI','COL','VEN','ECU','PER','BOL','CHL','ARG','PRY','URY']
TY0, TYB, TY1 = 190, 262, 440          # 1790–1808 compressed above TYB, 1808–1825 stretched below
def ty(y):
    if y <= 1808: return round(TY0 + (y - 1790) * (TYB - TY0) / 18, 1)
    return round(TYB + (y - 1808) * (TY1 - TYB) / 17, 1)
def strip(a, z):
    o = P(f'M40 {TY0}V{TYB - 3}M40 {TYB + 3}V{TY1}', 'thin')
    o += P(f'M35 {TYB - 5}L45 {TYB - 1}M35 {TYB + 1}L45 {TYB + 5}', 'thin')
    o += f'<rect x="36" y="{ty(a)}" width="8" height="{max(3, ty(z) - ty(a))}" style="fill:var(--conc)"/>'
    for yr in (1791, 1804, 1808, 1812, 1816, 1820, 1824):
        o += P(f'M36 {ty(yr)}H44', 'ink') + T(52, ty(yr) + 4, str(yr), 't-small' + (' tc-conc' if a <= yr <= z else ''))
    return o
def crisis(k):
    if k == 0:
        m = latam_map({**{c: 'conc' for c in SPAIN}, 'BRA': 'mix', 'HTI': 'dif'}, ['HTI', 'BRA'],
                      title='1808: A AMÉRICA SEM O REI', skip_seas=('OCEANO PACÍFICO',), key=[('conc', 'América espanhola'), ('mix', 'América portuguesa'), ('dif', 'Haiti, independente em 1804')])
        return m + strip(1791, 1808)
    if k == 1:
        m = latam_map({'COL': 'dif', 'VEN': 'dif'}, [], title='1810–1812: O LABORATÓRIO DA NOVA GRANADA', skip_seas=('OCEANO PACÍFICO',),
                      pins=[(-75.5, 10.4, 'Cartagena', 'end', -6, -4), (-74.1, 4.7, 'Cundinamarca', 'end', -6, 4), (-66.9, 10.5, 'Caracas', 'start', 6, -4)])
        return m + strip(1810, 1812)
    if k == 2:
        m = latam_map({**{c: 'dif' for c in SPAIN}, 'PER': 'conc'}, ['PER'], title='1812: A NAÇÃO DE AMBOS OS HEMISFÉRIOS', skip_seas=('OCEANO PACÍFICO',),
                      pins=[(-77.0, -12.05, 'Lima, 1823', 'end', -6, 4)], key=[('dif', 'sob a Constituição de Cádiz'), ('conc', 'Peru: a marca gaditana dura')])
        return m + strip(1812, 1823)
    m = latam_map({'BRA': 'dif'}, ['BRA'], title='1808–1824: O BRASIL, POR OUTRO CAMINHO', skip_seas=('OCEANO PACÍFICO',),
                  pins=[(-43.2, -22.9, 'Rio de Janeiro', 'end', -6, 14)])
    return m + strip(1808, 1824)

# ---- Fig 2: three foundational projects and their fusions
def projects(k):
    o = T(40, 56, 'TRÊS PROJETOS, TRÊS FUSÕES POSSÍVEIS', 't-small', style='letter-spacing:.1em')
    pts = {'C': (300, 130), 'L': (110, 450), 'R': (490, 450)}
    edges = [('C', 'R', 0), ('L', 'R', 1), ('L', 'C', 2)]
    for a, b_, e in edges:
        (x1, y1), (x2, y2) = pts[a], pts[b_]
        on = (k == 1 and e == 0) or (k == 2 and e == 1) or (k == 3 and e == 2)
        style = 'stroke-width:5' if on else ''
        cls = ('c-conc' if e == 2 else 'c-dif') + ' grow' if on else 'thin'
        o += P(f'M{x1} {y1}L{x2} {y2}', cls, style=style)
    labels = {'C': ('CONSERVADOR', 'a cruz e a espada'), 'L': ('LIBERAL', 'direitos invioláveis'), 'R': ('REPUBLICANO', 'autogoverno da maioria')}
    for key, (x, y) in pts.items():
        t, s = labels[key]
        o += G(box(x - 95, y - 34, 190, 68, t, s, 'paper', tcls='t-small', ctx='proj'), 'pop', d=.1)
    if k == 0:
        o += G(T(300, 300, 'dois ideais em disputa:', 't-small', anchor='middle') + T(300, 322, 'autonomia individual', 't-mid tc-dif', anchor='middle') + T(300, 346, 'e autogoverno coletivo', 't-mid tc-dif', anchor='middle'), 'fade', d=.3)
    else:
        mid = {1: (395, 290, 'Haiti 1805, México 1814'), 2: (300, 515, 'México 1857, Venezuela 1811, Peru 1823'), 3: (205, 290, 'a que venceu')}[k]
        o += G(T(mid[0], mid[1], mid[2], 't-small', anchor='middle'), 'fade', d=.4)
        note = {1: 'unidos contra os direitos invioláveis', 2: 'unidos contra o Executivo forte', 3: 'direitos individuais + Executivo concentrado'}[k]
        o += G(T(300, 560, note, 't-hand', anchor='middle'), 'fade', d=.5)
    return o

b = map_defs()
b += chapter('01', 'c1', 'Por que começar pela história', 'Para entender por que as cortes latino-americanas ganharam tanto poder depois das ditaduras, é preciso ver o que as Constituições da região sempre prometeram, e a quem.', 'dif')
b += longform(
    '<p>A professora abre a disciplina com uma escolha de método: a <strong>análise de larga duração</strong>. Ela não se mede pela quantidade de anos cobertos, mas pela conexão entre passado e presente. A pergunta não é “o que aconteceu em 1812?”, e sim “o que de 1812 continua funcionando hoje?”.</p>',
    '<p>A hipótese que guia a aula vem de Waldo Ansaldi e Verónica Giordano. A ordem pós-colonial, dizem eles, não rompeu radicalmente com o passado: completou a formação da nova ordem sobre as mesmas matrizes sociais (a fazenda, o latifúndio, a plantation), com uma matriz institucional eclética, que misturava componentes capitalistas com outros que não eram. Constituições novas sobre sociedades velhas.</p>',
    '<p>As palavras que atravessam a aula são as da Modernidade: liberdade, igualdade, democracia, revolução, direitos do homem, cidadania, Constituição. O interesse está em ver quem ficou dentro e quem ficou fora de cada uma delas.</p>')

b += chapter('02', 'c2', 'Haiti: a primeira resposta', 'A primeira experiência constitucional latino-americana foi feita por pessoas escravizadas.')
b += longform(
    '<p>A história costuma começar pelas repúblicas hispano-americanas. A aula começa antes, em Saint-Domingue. Em 1791, uma grande insurreição de escravizados dá início à Revolução Haitiana. A escravidão é abolida no território em 1793 e 1794 (neste ano, também pela Convenção Nacional francesa). Em 1801, a Constituição de Toussaint Louverture organiza o território com autonomia e abolição. Napoleão tenta, em 1802, restabelecer o domínio colonial e a escravidão. Em 1804 o Haiti se torna independente: a primeira independência de uma colônia “latino-americana” e a primeira revolução vitoriosa de escravizados da história moderna. Em 1805, a Constituição Imperial de Dessalines consolida a ruptura.</p>',
    '<p>O significado constitucional é duplo. Liberdade e igualdade deixam de ser princípios abstratos e viram fundamento de uma ruptura concreta com a escravidão; e a Constituição passa a ser instrumento de emancipação anticolonial. O Haiti também deixa uma pergunta que vai atravessar todo o constitucionalismo da região: <strong>quem pode ser reconhecido como sujeito de direitos e membro do povo soberano?</strong></p>')

b += chapter('03', 'c3', '1808: quem é soberano sem o rei?', 'A invasão napoleônica abre um vazio de autoridade, e a América responde antes de Cádiz.', 'dif')
b += scrolly('A crise de 1808 e as respostas constitucionais (fronteiras atuais)', [('p-cr0', crisis(0), '1808'), ('p-cr1', crisis(1), 'Nova Granada'), ('p-cr2', crisis(2), 'Cádiz'), ('p-cr3', crisis(3), 'Brasil')], [
    S('p-cr0', '1808', 'O vazio', '<p>Napoleão invade a Espanha, Fernando VII é deposto e José Bonaparte assume o trono. Sem monarca legítimo, formam-se juntas de governo na Espanha e na América, e são convocadas as Cortes de Cádiz. A questão fundamental é simples de formular e difícil de responder: <strong>quem exerce a soberania quando o rei não pode exercê-la?</strong></p><p>A resposta das colônias foi a ideia de “retorno” da soberania aos povos: juntas e cabildos, reivindicação de autonomia, afirmação de direitos naturais, novos corpos políticos e constituições escritas.</p>', 'conc'),
    S('p-cr1', '1810–1812', 'O laboratório da Nova Granada', '<p>Socorro (1810), Cundinamarca, Venezuela, Tunja e as Províncias Unidas (1811), Antioquia e Cartagena (1812): textos com soberania popular, representação, separação de poderes, direitos e governo limitado, produzidos antes ou ao lado de Cádiz.</p><p>Eles não deram uma única resposta. Cundinamarca apostou na <strong>centralização</strong>; Tunja, Antioquia, Cartagena e as Províncias Unidas preservaram os poderes provinciais, no caminho <strong>federal</strong>. A independência envolvia duas perguntas: como romper com a monarquia e como organizar a nova soberania.</p>', 'dif'),
    S('p-cr2', '1812 e depois', 'Cádiz: incluir e excluir no mesmo texto', '<p>Promulgada em 19 de março de 1812, a Constituição de Cádiz declara que a Nação espanhola é “la reunión de todos los españoles de ambos hemisferios” (art. 1º) e que a soberania reside essencialmente na Nação (art. 3º). Indígenas americanos são reconhecidos como cidadãos; desaparece a distinção política entre peninsulares e americanos.</p><p>Mas o art. 22 deixa aos originários da África apenas “la puerta de la virtud y del merecimiento”: são espanhóis, com direitos civis, sem cidadania, que só as Cortes poderiam conceder a quem cumprisse uma série de condições. Cádiz universaliza a cidadania dentro de limites profundamente marcados pela raça.</p><p>O texto circulou e foi apropriado. No Peru, a Constituição de 1823 carrega sua marca, e estudos recentes mostram comunidades indígenas usando os <em>ayuntamientos</em> gaditanos para ampliar seu autogoverno, mesmo depois da revogação.</p>', 'conc'),
    S('p-cr3', '1808–1824', 'O Brasil, por outro caminho', '<p>A Corte portuguesa chega ao Rio em 1808; o Brasil vira Reino Unido em 1815; a Revolução do Porto (1820) pressiona a monarquia; em 1821 a Constituição de Cádiz chega a ser jurada no Brasil, e D. João VI volta a Portugal. A independência de 1822 preserva a continuidade dinástica.</p><p>A Constituição de 1824 segue outro rumo: monarquia constitucional, Executivo forte, <strong>Poder Moderador</strong>, Senado vitalício, centralização e unidade territorial. Cádiz fez parte da experiência brasileira, mas não do seu desenho final.</p>', 'dif'),
])

b += bet('Cádiz declarou a soberania da Nação, reconheceu indígenas como cidadãos e aboliu a distinção política entre espanhóis da península e da América. Foi uma Constituição de igualdade?', [
    ('Sim: pela primeira vez, americanos e peninsulares viraram cidadãos da mesma Nação.', ''),
    ('Não: pessoas de origem africana ficaram sem cidadania, a menos que as Cortes a concedessem.', ''),
    ('As duas coisas: universalizou a cidadania dentro de limites marcados pela raça.', '*a leitura da aula'),
], '<p>A terceira resposta é a da professora: inclusão e exclusão no mesmo projeto. É a mesma pergunta que o Haiti tinha deixado, agora respondida pela metrópole.</p>')

b += chapter('04', 'c4', 'Três projetos e um pacto', 'O século XIX latino-americano discutiu duas ideias, e acabou escolhendo uma combinação.')
b += longform(
    '<p>A aula organiza o primeiro constitucionalismo (1810–1850) com uma tipologia que Roberto Gargarella tornou conhecida. Dois ideais estavam em disputa: a <strong>autonomia individual</strong> e o <strong>autogoverno coletivo</strong>. Três projetos constituintes responderam a eles de modos diferentes.</p>')
b += scrolly('Os projetos fundacionais e suas fusões', [('p-pj0', projects(0), 'Três projetos'), ('p-pj1', projects(1), 'Conservador e republicano'), ('p-pj2', projects(2), 'Republicano e liberal'), ('p-pj3', projects(3), 'Liberal e conservador')], [
    S('p-pj0', '1810–1850', 'Os três projetos', '<p>O <strong>conservador</strong>, o modelo “da cruz e da espada”, restringe os dois ideais: concentra poder no Executivo e submete os direitos a uma concepção de bem ligada aos valores da Igreja (Chile 1823, Colômbia 1843 e 1886, México 1843, Peru 1839). O <strong>liberal</strong> defende as liberdades individuais, desconfia das maiorias e quer poderes limitados e equilibrados (Argentina 1826, Chile 1828, Nova Granada 1830, Peru 1828, Uruguai 1830). O <strong>republicano</strong> aposta no autogoverno e na vontade geral, e desconfia de direitos reconhecidos a priori (México 1814, Peru 1823, Venezuela 1811, Equador 1830 e 1850).</p>', 'dif'),
    S('p-pj1', 'A fusão improvável', 'Conservadores e republicanos radicais', '<p>A fusão menos provável uniu dois projetos opostos em quase tudo, menos na rejeição aos direitos individuais invioláveis do projeto liberal. Exemplos: as Constituições do Haiti de 1805 e do México de 1814.</p>', 'dif'),
    S('p-pj2', 'A fusão antibolivariana', 'Republicanos e liberais', '<p>O ponto comum foi o combate ao conservadorismo: ao excesso de poder concentrado no Executivo e aos ataques às garantias individuais. Exemplos: México 1857, Venezuela 1811, Peru 1823.</p>', 'dif'),
    S('p-pj3', 'A fusão que venceu', 'Liberais e conservadores', '<p>A que se consolidou e se espalhou por quase toda a região uniu-se contra as “decisões irracionais” das maiorias republicanas. Os conservadores aceitaram direitos individuais inalienáveis; os liberais aceitaram um Executivo concentrado. O resultado é a marca do constitucionalismo latino-americano: <strong>catálogos de direitos generosos ao lado de presidentes muito fortes</strong>.</p><p>No Brasil, a aliança começa no Império e chega ao ponto alto na passagem à República, com a Constituição de 1891. A Argentina de 1853, mais próxima do modelo norte-americano (federalismo, presidencialismo), conserva elementos da matriz hispânica e gaditana.</p>', 'conc'),
])

b += chapter('05', 'c5', 'Do liberal ao social, e do social às cortes', 'Quando a Constituição passa a exigir, alguém precisa cobrar.', 'dif')
b += longform(
    '<p>No fim do século XIX, o constitucionalismo liberal girava em torno da liberdade individual, da propriedade, da igualdade formal e da limitação do Estado. A questão social mudou a agenda: industrialização, urbanização, desigualdade, organização dos trabalhadores, as revoluções Mexicana e Russa, a crise do liberalismo. A Constituição ganhou uma nova função: não só limitar o Estado, mas <strong>exigir</strong> sua atuação para produzir igualdade material.</p>',
    '<p>A América Latina participou cedo dessa virada. A Constituição mexicana de 1917 abre o caminho: direitos trabalhistas, limite de horas de trabalho, salário mínimo, sindicatos, função social da propriedade, reforma agrária, educação. Seguem-se a Constituição brasileira de 1934, a reforma constitucional colombiana de 1936 (que emendou a Carta de 1886) e a Constituição boliviana de 1938.</p>',
    '<p>A mudança cria um problema que liga esta aula a todo o resto da disciplina. Se a Constituição contém direitos sociais, normas sobre trabalho, saúde, educação e ordem econômica, <strong>quem garante que eles serão cumpridos?</strong> A resposta do século XX foi a justiça constitucional.</p>',
    '<p>Depois das ditaduras da segunda metade do século, a pergunta ganhou urgência. Os regimes autoritários deixaram ruptura da ordem constitucional, Executivos hipertrofiados, direitos suprimidos, violência de Estado e instituições instrumentalizadas. A redemocratização respondeu com novas Constituições, catálogos de direitos maiores, tribunais constitucionais criados ou fortalecidos e acesso ampliado à justiça constitucional. A Constituição passou a ser pensada também como <strong>garantia contra a repetição do autoritarismo</strong>, e os juízes passaram a ocupar um lugar que antes não tinham.</p>',
    eixo('Se o constitucionalismo latino-americano sempre combinou direitos amplos com Executivos fortes, o que muda quando as cortes passam a ser chamadas a garantir esses direitos?', 'Pergunta que liga esta aula à seguinte'),
    '<p>A segunda metade da aula de 17/08 responde a essa pergunta com dados: quem são os juízes das cortes supremas, como chegam lá e por que algumas cortes ganharam autonomia e outras não.</p>')

b += chapter('06', 'c6', 'Teste', 'Responda antes de abrir.')
b += quiz([
    ('O que é a análise de larga duração, no sentido usado pela professora?', 'Uma análise que não se mede pela quantidade de anos, mas pela conexão entre passado e presente: busca as continuidades, a presença do passado no presente.'),
    ('Por que o Haiti é o ponto de partida da aula?', 'Porque produziu a primeira experiência constitucional latino-americana, fundada na abolição da escravidão, na soberania e na ruptura colonial, e deixou a pergunta sobre quem pode ser sujeito de direitos e membro do povo soberano.'),
    ('O que é o “paradoxo de Cádiz”?', 'Cádiz rompe com o absolutismo (soberania da Nação, poder submetido à Constituição, representação) mas quer preservar a monarquia e a unidade do império. E, ao universalizar a cidadania, exclui dela as pessoas de origem africana (art. 22).'),
    ('Qual a diferença entre os projetos conservador, liberal e republicano?', 'O conservador restringe autonomia individual e autogoverno, concentra poder e subordina direitos a valores religiosos. O liberal protege liberdades individuais e desconfia das maiorias. O republicano privilegia o autogoverno e a vontade geral, e desconfia de direitos a priori.'),
    ('Qual fusão se consolidou, e qual sua marca?', 'A liberal-conservadora: conservadores aceitaram direitos individuais, liberais aceitaram um Executivo concentrado. Daí a combinação típica da região: direitos amplos e presidentes fortes.'),
    ('Como o constitucionalismo social leva à justiça constitucional?', 'Ao incluir direitos sociais e deveres de atuação do Estado, a Constituição passa a exigir mecanismos que garantam seu cumprimento. Depois das ditaduras, a resposta foi fortalecer tribunais constitucionais e o acesso a eles.'),
])

lesson('01', 'aula-01.html', 'Constitucionalismo latino-americano',
       'Constitucionalismo na América Latina em larga duração: Haiti, a crise de 1808, o laboratório da Nova Granada, Cádiz, o Brasil imperial, os três projetos fundacionais, o constitucionalismo social e a redemocratização.',
       'Constitucionalismo', 'latino-americano',
       'De 1791 às cortes de hoje, a mesma pergunta volta: <strong class="dif">quem é o povo soberano</strong>, e quem fica <strong class="conc">fora da cidadania</strong> que a Constituição promete.',
       hero, [('Aula', '17/08 · parte 1'), ('Leitura', '≈ 18 min'), ('Antes', 'Início do curso'), ('Depois', 'Aula 02 · Cortes')], b,
       ('index.html', '← Curso', 'Direito Latino-americano'), ('aula-02.html', 'Aula 02 →', 'Cortes e democratização'), '17/08')
